# Keeper — copy to .env and fill in. NEVER commit .env.

# --- Minds platform ---------------------------------------------------------
# Builder API key, minted at https://build.hellominds.ai/console (shown once).
# Canonical header is X-Api-Key; MINDS_ACCESS_KEY is accepted as a legacy fallback.
MINDS_BUILDER_API_KEY=

# The Steward Mind (memory + moderation judgment). From build.hellominds.ai.
MINDS_MIND_ID=

# The Rewards Mind (wallet). Optional until Phase 5; blank = circle/wallet spikes skip.
MINDS_REWARDS_MIND_ID=

# Optional override. Default: https://api.build.hellominds.ai
MINDS_API_BASE_URL=

# x-api-key (default) | x-access-key | auto  — "auto" retries the legacy header on 401/403.
MINDS_AUTH_HEADER=

# --- Telegram ---------------------------------------------------------------
# From @BotFather. The bot must be an ADMIN of the demo supergroup.
TELEGRAM_BOT_TOKEN=

# Numeric Telegram user id of the creator (for digest DMs). The creator must
# /start the bot once before the bot can DM them.
CREATOR_TELEGRAM_ID=

# Numeric id of the demo supergroup (negative, e.g. -1001234567890).
DEMO_GROUP_ID=

# --- Keeper connector (all optional; the defaults below are what the code uses) ------
# Community name, used verbatim in the envelope's `group:` line.
KEEPER_GROUP_NAME=Ada's Editing Lab

# SQLite MIRROR path (relative to the repo root). A mirror only: relationship memory
# lives in the Steward Mind. Deleting this file must not lose who anyone is.
KEEPER_MIRROR_PATH=var/keeper.db

# ONE long-lived Minds conversation for the whole community. Do not rotate it.
KEEPER_MIND_ALIAS=keeper-steward

# Give-up point for a Mind exchange. Measured latency is 23-65s (docs/API-NOTES.md).
KEEPER_MIND_TIMEOUT_MS=300000

# Minutes east of UTC. Hong Kong = 480. Sets envelope timestamps and the budget day.
KEEPER_UTC_OFFSET_MINUTES=480

# BUILD_PLAN §7 Cognition budget: hard cap on Mind exchanges per local day, and the
# slice of it reserved for joins / returns / creator commands.
KEEPER_DAILY_MIND_BUDGET=40
KEEPER_PRIORITY_RESERVE=10

# 1-in-N ambient sampling for relationship colour. 0 disables it.
KEEPER_AMBIENT_SAMPLE_RATE=12

# Mind-exchange backlog per chat before new jobs are dropped (and logged).
KEEPER_QUEUE_MAX_PENDING=20

# Telegram refuses deleteMessage past 48h. Leave this alone.
KEEPER_DELETE_WINDOW_MS=172800000

# Demo harness only: attribute "@handle: text" posted by our own bot to that cast member.
# Never enable for a real community.
KEEPER_SEED_ATTRIBUTION=false
